# Start from the repository root. Never commit .env.
DATABASE_URL=postgresql+psycopg://breathewise:breathewise@127.0.0.1:5432/breathewise
DATA_MODE=live
# Allowed CORS origins (comma-separated for multi-origin or production deployment)
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATA_ROOT=data
MODEL_ARTIFACT_PATH=artifacts/models/zero_input_aq_weather_model.joblib
# Model runtime is deliberately disabled pending verified source/parity.

# Frontend build-time variable for remote production API (leave blank for local Vite proxy)
# VITE_API_BASE_URL=https://your-breathewise-api.onrender.com

# Server-only OpenAQ v3 key, configure locally; never expose through VITE_*
OPENAQ_API_KEY=

# Server-local audited archive, not committed and never interpreted as UTC
ARCHIVE_ROOT=data/archive
FORECAST_REGISTRY_ROOT=work/forecast-experiment
# Opt in to a documented OSRM endpoint; blank disables external route requests
ROUTING_BASE_URL=
